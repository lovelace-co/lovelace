{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lovelace-agent digest"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lovelace-agent session-check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lovelace-agent guard"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lovelace-agent presence-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lovelace-agent presence-clear"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lovelace-agent track-active"
          }
        ],
        "matcher": "mcp__lovelace__set_active_ticket"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lovelace-agent presence-beat"
          }
        ]
      }
    ]
  }
}
