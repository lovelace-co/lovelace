{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./packages/mcp/dist/helper.js digest"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./packages/mcp/dist/helper.js session-check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./packages/mcp/dist/helper.js guard"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./packages/mcp/dist/helper.js presence-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./packages/mcp/dist/helper.js presence-clear"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./packages/mcp/dist/helper.js track-active"
          }
        ],
        "matcher": "mcp__lovelace__set_active_ticket"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./packages/mcp/dist/helper.js presence-beat"
          }
        ]
      }
    ]
  }
}
