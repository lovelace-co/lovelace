{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lovelace",
  "mainBinaryName": "Lovelace",
  "version": "0.1.0",
  "identifier": "co.lovelace.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm --filter @lovelace/desktop exec vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Lovelace",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundColor": "#14181d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/lovelace-host",
      "binaries/lovelace-agent",
      "binaries/lovelace-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://lovelace.co/releases/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MzZGMjRDNjhDRUVBQzQKUldURTZzNW9UUEkyWlRmcE1TdUR0WUUrL0dCV1k2VjlZdjZ3OXcxVXpaYUVOT3c0YVA1MXUybisK"
    }
  }
}
