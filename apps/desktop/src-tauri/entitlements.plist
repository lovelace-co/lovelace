<plist version="1.0">
<dict>
	<!-- The sidecars are Bun-compiled and JavaScriptCore needs JIT pages;
	     the hardened runtime forbids executable allocation without this. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
